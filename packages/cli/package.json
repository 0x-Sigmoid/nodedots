{
  "name": "nodedots",
  "version": "0.1.0",
  "description": "Local advisory pull request pre-flight analysis for supported JavaScript and TypeScript repositories",
  "license": "Apache-2.0",
  "bin": {
    "nodedots": "dist/nodedots.cjs"
  },
  "files": [
    "dist/nodedots.cjs",
    "dist/build.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "verify-package.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0x-Sigmoid/nodedots.git",
    "directory": "packages/cli"
  },
  "homepage": "https://nodedots.com/doc/pre-flight-cli",
  "bugs": {
    "url": "https://github.com/0x-Sigmoid/nodedots/issues"
  },
  "keywords": [
    "cli",
    "code-review",
    "change-impact",
    "preflight",
    "typescript",
    "javascript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepack": "node verify-package.cjs"
  }
}
